          "title": "Lifts",
          "type": "integer"
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "stairs": {
          "default": 0,
          "minimum": 0,
          "title": "Stairs",
          "type": "integer"
        }
      },
      "required": [
        "shape"
      ],
      "title": "CoreZone",
      "type": "object"
    },
    "FlatModule": {
