            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor To Floor M"
        },
        "stilt_height_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stilt Height M"
        }
      },
