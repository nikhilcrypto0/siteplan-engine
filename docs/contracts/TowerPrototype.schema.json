        "holes": {
          "default": [],
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Holes",
          "type": "array"
        },
        "outer": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Outer",
          "type": "array"
        }
      },
      "required": [
        "outer"
      ],
      "title": "Shape",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "SURVEY",
        "ARCHITECT",
        "DOCUMENT",
        "FIRM_STANDARD",
        "FIRM_FINISHED_PLAN",
        "ENGINE_DEFAULT",
        "TEST_PROFILE"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "Stretch": {
      "additionalProperties": false,
      "description": "A block that can be built longer or shorter by whole modules.",
      "properties": {
        "max_modules": {
          "exclusiveMinimum": 0,
          "title": "Max Modules",
          "type": "integer"
        },
        "min_modules": {
          "exclusiveMinimum": 0,
          "title": "Min Modules",
          "type": "integer"
        },
        "module_pitch_m": {
          "exclusiveMinimum": 0,
          "title": "Module Pitch M",
          "type": "number"
        }
      },
      "required": [
        "module_pitch_m",
        "min_modules",
        "max_modules"
      ],
      "title": "Stretch",
      "type": "object"
    }
