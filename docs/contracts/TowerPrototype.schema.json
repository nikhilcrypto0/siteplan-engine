        "$ref": "#/$defs/CoreZone"
      },
      "title": "Core Zones",
      "type": "array"
    },
    "cores": {
      "minimum": 0,
      "title": "Cores",
      "type": "integer"
    },
    "corridor": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Shape"
      },
      "title": "Corridor",
      "type": "array"
    },
    "depth_m": {
      "exclusiveMinimum": 0,
      "title": "Depth M",
      "type": "number"
    },
    "family": {
      "$ref": "#/$defs/PrototypeFamily"
    },
    "footprint": {
      "$ref": "#/$defs/Shape"
    },
    "heights": {
      "$ref": "#/$defs/PrototypeHeights",
      "default": {
        "floor_to_floor_m": null,
        "stilt_height_m": null
      }
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "length_m": {
      "exclusiveMinimum": 0,
      "title": "Length M",
      "type": "number"
    },
    "modules": {
      "items": {
        "$ref": "#/$defs/FlatModule"
      },
      "minItems": 1,
      "title": "Modules",
      "type": "array"
    },
    "per_floor": {
      "$ref": "#/$defs/PerFloor"
    },
    "schema_version": {
      "const": "1.2",
      "default": "1.2",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "default": "",
      "title": "Source",
      "type": "string"
    },
    "source_kind": {
      "$ref": "#/$defs/SourceKind"
    },
    "stretch": {
      "anyOf": [
        {
          "$ref": "#/$defs/Stretch"
        },
        {
          "type": "null"
        }
      ],
      "default": null
