    "PrototypeFamily": {
      "enum": [
        "SINGLE_CORE_SMALL",
        "SINGLE_CORE",
        "TWO_CORE_MEDIUM",
        "TWO_CORE_LARGE",
        "LEGACY_RECTANGLE"
