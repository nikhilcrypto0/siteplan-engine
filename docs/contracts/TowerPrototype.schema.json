          "default": null,
          "title": "Carpet Sqft"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "saleable_sqft": {
          "exclusiveMinimum": 0,
          "title": "Saleable Sqft",
          "type": "number"
