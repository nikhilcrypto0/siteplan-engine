{
  "$defs": {
    "AmenityPriority": {
      "enum": [
        "REQUIRED",
        "PREFERRED",
        "OPTIONAL"
      ],
      "title": "AmenityPriority",
      "type": "string"
    },
    "AmenityRequest": {
      "additionalProperties": false,
      "description": "A facility the firm wants. Its use and surface are the firm's to state, in its amenity\nlibrary; left unstated they are None, and nothing downstream assumes them from the name.\nWhether its ground counts as organised open space is the law's (ResolvedRules), not ours.",
      "properties": {
        "footprint_m": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footprint M"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/AmenityPriority",
          "default": "PREFERRED"
        },
        "setting": {
          "$ref": "#/$defs/AmenitySetting",
          "default": "EITHER"
        },
        "surface": {
          "anyOf": [
            {
              "$ref": "#/$defs/Surface"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "use": {
          "anyOf": [
            {
              "$ref": "#/$defs/FacilityUse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "AmenityRequest",
      "type": "object"
    },
    "AmenitySetting": {
      "enum": [
        "CLUB_HOUSE",
        "OUTDOOR",
        "EITHER"
      ],
      "title": "AmenitySetting",
      "type": "string"
    },
    "ClubHouseRequest": {
      "additionalProperties": false,
      "properties": {
        "floors": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floors"
        },
        "size": {
          "$ref": "#/$defs/ClubSize",
          "default": "LEGAL_MINIMUM"
        },
        "sqm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sqm"
        },
        "wanted": {
          "$ref": "#/$defs/Sourced_bool_"
        }
      },
      "required": [
        "wanted"
      ],
      "title": "ClubHouseRequest",
      "type": "object"
    },
    "ClubSize": {
      "enum": [
        "LEGAL_MINIMUM",
        "FIRM_STANDARD",
        "STATED"
      ],
      "title": "ClubSize",
      "type": "string"
    },
    "DesignMargins": {
      "additionalProperties": false,
      "description": "What to keep in hand above each legal minimum. Each margin is the firm's standard or the\nengine's design assumption, never law, and none is invented here: with nothing set every\nmargin is zero and the target is the legal minimum itself.",
      "properties": {
        "open_space_extra_fraction": {
          "$ref": "#/$defs/Sourced_float_"
        },
        "parking_extra_fraction": {
          "$ref": "#/$defs/Sourced_float_"
        },
        "road_width_extra_m": {
          "$ref": "#/$defs/Sourced_float_"
        },
        "setback_extra_m": {
          "$ref": "#/$defs/Sourced_float_"
        },
        "tower_gap_extra_m": {
          "$ref": "#/$defs/Sourced_float_"
        }
      },
      "title": "DesignMargins",
      "type": "object"
    },
    "FacilityUse": {
      "description": "What a facility is for. The first three are the uses rule 7(a)(vii) names for organised\nopen space ('greenery, tot lot or soft landscaping etc.').",
      "enum": [
        "GREENERY",
        "TOT_LOT",
        "SOFT_LANDSCAPE",
        "SPORT_COURT",
        "POOL",
        "PAVED_DECK",
        "BUILT_SERVICE",
        "OTHER"
      ],
      "title": "FacilityUse",
      "type": "string"
    },
    "FirmStandards": {
      "additionalProperties": false,
      "properties": {
        "aisle_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bay_size_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced_tuple_float__float__"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cellar_floor_height_m": {
          "$ref": "#/$defs/Sourced_float_"
        },
        "cellar_utilities_share": {
          "$ref": "#/$defs/Sourced_float_"
        },
        "common_area_loading_pct": {
          "$ref": "#/$defs/Sourced_float_"
        },
        "floor_to_floor_m": {
          "$ref": "#/$defs/Sourced_float_"
        },
        "max_cores_per_tower": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced_int_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_tower_length_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "min_flats_per_side": {
          "$ref": "#/$defs/Sourced_int_"
        },
        "preferred_prototype_families": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Preferred Prototype Families",
          "type": "array"
        },
        "stilt_height_m": {
          "$ref": "#/$defs/Sourced_float_"
        }
      },
      "required": [
        "stilt_height_m",
        "floor_to_floor_m",
        "cellar_floor_height_m",
        "common_area_loading_pct",
        "cellar_utilities_share",
        "min_flats_per_side"
      ],
      "title": "FirmStandards",
      "type": "object"
    },
    "HeightIntent": {
      "additionalProperties": false,
      "properties": {
        "floors_above_stilt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floors Above Stilt"
        },
        "floors_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floors Range"
        },
        "has_stilt": {
          "default": true,
          "title": "Has Stilt",
          "type": "boolean"
        },
        "min_floors_above_stilt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Floors Above Stilt"
        },
        "mixed_heights_allowed": {
          "default": true,
          "title": "Mixed Heights Allowed",
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/HeightMode",
          "default": "MAX_LEGAL"
        },
        "notation": {
          "$ref": "#/$defs/Sourced_str_"
        }
      },
      "required": [
        "notation"
      ],
      "title": "HeightIntent",
      "type": "object"
    },
    "HeightMode": {
      "enum": [
        "MAX_LEGAL",
        "FIXED",
        "RANGE"
      ],
      "title": "HeightMode",
      "type": "string"
    },
    "Objectives": {
      "additionalProperties": false,
      "properties": {
        "options": {
          "default": 3,
          "exclusiveMinimum": 0,
          "title": "Options",
          "type": "integer"
        },
        "pareto": {
          "default": [
            "MAX_YIELD",
            "BALANCED",
            "CONVENTIONAL_OPEN_SPACE",
            "ROBUST"
          ],
          "items": {
            "$ref": "#/$defs/ParetoPoint"
          },
          "title": "Pareto",
          "type": "array"
        },
        "priorities": {
          "additionalProperties": {
            "type": "number"
          },
          "default": {},
          "propertyNames": {
            "$ref": "#/$defs/Priority"
          },
          "title": "Priorities",
          "type": "object"
        },
        "search_budget_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search Budget S"
        },
        "soft_preferences": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SoftPreference"
          },
          "title": "Soft Preferences",
          "type": "array"
        }
      },
      "title": "Objectives",
      "type": "object"
    },
    "ParetoPoint": {
      "enum": [
        "MAX_YIELD",
        "BALANCED",
        "CONVENTIONAL_OPEN_SPACE",
        "ROBUST"
      ],
