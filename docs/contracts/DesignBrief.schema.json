    "Surface": {
      "description": "What a facility's ground is made of. Stated by whoever specifies the facility (the firm's\namenity library); never read off its name.",
      "enum": [
        "SOFT",
        "HARD",
        "BUILT"
      ],
      "title": "Surface",
      "type": "string"
    },
    "UnitTarget": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "mode": {
          "$ref": "#/$defs/UnitsMode",
          "default": "MAXIMISE"
        },
        "target": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
