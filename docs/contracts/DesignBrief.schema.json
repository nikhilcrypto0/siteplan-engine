        "surface_bays_allowed": {
          "default": true,
          "title": "Surface Bays Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "max_cellars"
      ],
      "title": "ParkingPreferences",
      "type": "object"
    },
    "Priority": {
      "description": "What an objective may weigh. A priority left out counts as 1.",
      "enum": [
        "saleable_area",
        "units",
        "open_space",
        "mix_fit",
        "conventionality"
      ],
      "title": "Priority",
      "type": "string"
    },
    "Program": {
      "additionalProperties": false,
      "properties": {
        "allowed_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Types",
          "type": "array"
        },
        "amenities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AmenityRequest"
          },
          "title": "Amenities",
          "type": "array"
        },
        "amenity_library": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "club_house": {
          "$ref": "#/$defs/ClubHouseRequest"
        },
        "flat_library": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mix_tolerance": {
          "default": 0.05,
          "maximum": 1,
          "minimum": 0,
          "title": "Mix Tolerance",
          "type": "number"
        },
        "parking": {
          "$ref": "#/$defs/ParkingPreferences"
        },
        "unit_mix": {
          "$ref": "#/$defs/Sourced_dict_str__float__"
        },
        "units": {
          "$ref": "#/$defs/UnitTarget",
          "default": {
            "maximum": null,
            "minimum": null,
            "mode": "MAXIMISE",
            "target": null
          }
        }
      },
      "required": [
        "unit_mix",
        "club_house",
        "parking"
      ],
      "title": "Program",
      "type": "object"
    },
    "Provenance": {
      "enum": [
        "VERIFIED",
        "USER_CONFIRMED",
        "EXTRACTED",
        "ASSUMED_FOR_TEST",
        "UNVERIFIED"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "SoftPreference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "default": {},
          "title": "Params",
          "type": "object"
        },
        "weight": {
          "default": 1.0,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SoftPreference",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "SURVEY",
        "ARCHITECT",
