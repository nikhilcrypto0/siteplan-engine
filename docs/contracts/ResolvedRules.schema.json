    "GreenStripRules": {
      "additionalProperties": false,
      "description": "The planting strips. The high-rise strip: width_m where the setback is where_setback_from_m\nor more (rule 7(a)(viii)). Table III's (rule 5(f)): frontage_m along the frontage within the\nfront setback, and periphery_m on the remaining sides on plots above periphery_above_sqm.\nWhat each band asks is on the band (Band.green_strip_m), so no consumer works it out again.",
      "properties": {
        "frontage_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleValue_float_"
