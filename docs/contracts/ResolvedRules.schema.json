    "Band": {
      "additionalProperties": false,
      "description": "One row of the height tables: the heights it covers and what it asks of them. Each edge\nsays whether it belongs to the band, so every height falls in exactly one band: a building of\nexactly 21 m is a high-rise (rule 2(f)) and has its own row.\n\nA band's edges are read on its own `measure`: the rule height for Table IV's rows, the height\nabove the stilt for Table III's (rule 5(c)); `HeightRules.band_for_block` finds a block's band\neither way. `setback_m` is the setback on every side but the front when `front_setback_m` is\ngiven, all round when it is not. `permission` says whether a building of these heights may\nstand on this site at all (plot size, road), with the reason when it may not; a height the\ntables do not permit is a band of its own, so the bands still cover every height once.",
      "properties": {
        "above_inclusive": {
          "default": false,
          "title": "Above Inclusive",
          "type": "boolean"
        },
        "above_m": {
          "minimum": 0,
          "title": "Above M",
          "type": "number"
        },
        "clause": {
          "title": "Clause",
          "type": "string"
        },
        "front_setback_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Front Setback M"
        },
        "gap_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap M"
        },
        "green_strip_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Green Strip M"
        },
        "green_strip_sides": {
          "default": "ALL",
          "enum": [
            "ALL",
            "FRONTAGE"
          ],
          "title": "Green Strip Sides",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/BandKind"
        },
        "measure": {
          "$ref": "#/$defs/HeightMeasure",
          "default": "RULE_HEIGHT"
        },
        "min_road_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Road M"
        },
        "modelled": {
          "default": true,
          "title": "Modelled",
          "type": "boolean"
        },
        "permission": {
          "$ref": "#/$defs/Eligibility",
          "default": "ALLOWED"
        },
        "permission_note": {
          "default": "",
          "title": "Permission Note",
          "type": "string"
        },
        "setback_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setback M"
        },
        "status": {
          "$ref": "#/$defs/Provenance",
          "default": "VERIFIED"
        },
        "up_to_inclusive": {
          "default": true,
          "title": "Up To Inclusive",
          "type": "boolean"
        },
        "up_to_m": {
          "exclusiveMinimum": 0,
          "title": "Up To M",
          "type": "number"
        }
      },
      "required": [
        "above_m",
        "up_to_m",
        "kind",
        "clause"
      ],
      "title": "Band",
      "type": "object"
